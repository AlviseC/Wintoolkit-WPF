<Window x:Class="WinToolkitWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinToolkit Pro" Height="650" Width="900" Background="#1e1e1e" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Stile per i bottoni del Menù laterale -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stile per i bottoni delle azioni -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Barra laterale -->
            <ColumnDefinition Width="*"/>
            <!-- Contenuto -->
        </Grid.ColumnDefinitions>

        <!-- BARRA LATERALE (MENÙ) -->
        <Border Background="#252526" Grid.Column="0">
            <StackPanel>
                <TextBlock Text="🛠️ WinToolkit" Foreground="White" FontSize="22" FontWeight="Bold" Margin="15,20,15,30"/>

                <!-- Uso Font nativo di Windows per le icone -->
                <Button Style="{StaticResource MenuButton}" Click="Menu_Click" Tag="PanelSistema">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE770;" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="Manutenzione"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButton}" Click="Menu_Click" Tag="PanelSoftware">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="Installa Software"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButton}" Click="Menu_Click" Tag="PanelPortable">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE88E;" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="Software Portable"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuButton}" Click="Menu_Click" Tag="PanelStato">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="Stato Sistema"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- AREA CONTENUTO -->
        <Grid Grid.Column="1" Margin="20">

            <!-- PANNELLO 1: Manutenzione (I tuoi script) -->
            <ScrollViewer x:Name="PanelSistema" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Manutenzione di Sistema" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="Pulizia e Ripristino" Foreground="#007ACC" Margin="0,10,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="SFC Scan" Click="BtnScript_Click" Tag="sfc_scan.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="DISM Restore" Click="BtnScript_Click" Tag="dism_restore.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Clean Temp" Click="BtnScript_Click" Tag="clean_temp.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Disk Cleanup" Click="BtnScript_Click" Tag="disk_cleanup.bat"/>
                    </WrapPanel>

                    <TextBlock Text="Rete e Utility" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="Flush DNS" Click="BtnScript_Click" Tag="flush_dns.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Reset Network" Click="BtnScript_Click" Tag="reset_network.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Check Disk" Click="BtnScript_Click" Tag="chkdsk.bat"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Startup Manager" Click="BtnScript_Click" Tag="startup_manager.bat"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PANNELLO 2: Software (Winget & Choco) -->
            <ScrollViewer x:Name="PanelSoftware" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Gestione Software" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Installazione classica nel sistema operativo." Foreground="Gray" Margin="0,0,0,10"/>

                    <TextBlock Text="Browser" Foreground="#007ACC" Margin="0,10,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="Chrome" Click="BtnScript_Click" Tag="winget:Google.Chrome"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Firefox" Click="BtnScript_Click" Tag="winget:Mozilla.Firefox"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Brave" Click="BtnScript_Click" Tag="winget:Brave.Brave"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Opera GX" Click="BtnScript_Click" Tag="winget:Opera.OperaGX"/>
                    </WrapPanel>

                    <TextBlock Text="Utility" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="7-Zip" Click="BtnScript_Click" Tag="choco:7zip"/>
                        <Button Style="{StaticResource ActionBtn}" Content="WinRAR" Click="BtnScript_Click" Tag="winget:RARLab.WinRAR"/>
                        <Button Style="{StaticResource ActionBtn}" Content="PowerToys" Click="BtnScript_Click" Tag="winget:Microsoft.PowerToys"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Notepad++" Click="BtnScript_Click" Tag="choco:notepadplusplus"/>
                    </WrapPanel>

                    <TextBlock Text="Media &amp; Intrattenimento" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="VLC" Click="BtnScript_Click" Tag="choco:vlc"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Spotify" Click="BtnScript_Click" Tag="winget:Spotify.Spotify"/>
                        <Button Style="{StaticResource ActionBtn}" Content="OBS Studio" Click="BtnScript_Click" Tag="winget:OBSProject.OBSStudio"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Audacity" Click="BtnScript_Click" Tag="winget:Audacity.Audacity"/>
                    </WrapPanel>

                    <TextBlock Text="Produttività" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="LibreOffice" Click="BtnScript_Click" Tag="winget:TheDocumentFoundation.LibreOffice"/>
                        <Button Style="{StaticResource ActionBtn}" Content="VS Code" Click="BtnScript_Click" Tag="winget:Microsoft.VisualStudioCode"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Acrobat Reader" Click="BtnScript_Click" Tag="winget:Adobe.Acrobat.Reader.64-bit"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Zoom" Click="BtnScript_Click" Tag="winget:Zoom.Zoom"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PANNELLO 3: Software Portabile (Scoop) -->
            <ScrollViewer x:Name="PanelPortable" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Software Portabile" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Non toccano il registro e non richiedono diritti di amministratore." Foreground="Gray" Margin="0,0,0,10"/>

                    <!-- Pulsante fondamentale per far funzionare Scoop e aggiungere il repository "extras" -->
                    <Button Style="{StaticResource ActionBtn}" Content="🛠️ Installa Scoop" Click="BtnScript_Click" Tag="scoop_init" Width="180" Background="#005A9E"/>

                    <TextBlock Text="Sistema &amp; Diagnostica" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="Rufus" Click="BtnScript_Click" Tag="scoop:rufus"/>
                        <Button Style="{StaticResource ActionBtn}" Content="HWInfo" Click="BtnScript_Click" Tag="scoop:hwinfo"/>
                        <Button Style="{StaticResource ActionBtn}" Content="CPU-Z" Click="BtnScript_Click" Tag="scoop:cpu-z"/>
                        <Button Style="{StaticResource ActionBtn}" Content="BleachBit" Click="BtnScript_Click" Tag="scoop:bleachbit"/>
                    </WrapPanel>

                    <TextBlock Text="Grafica &amp; Media" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="VLC Portable" Click="BtnScript_Click" Tag="scoop:vlc"/>
                        <Button Style="{StaticResource ActionBtn}" Content="GIMP" Click="BtnScript_Click" Tag="scoop:gimp"/>
                        <Button Style="{StaticResource ActionBtn}" Content="OBS Portable" Click="BtnScript_Click" Tag="scoop:obs-studio"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Krita" Click="BtnScript_Click" Tag="scoop:krita"/>
                    </WrapPanel>

                    <TextBlock Text="Utility Varie" Foreground="#007ACC" Margin="0,20,0,5"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionBtn}" Content="7-Zip Portable" Click="BtnScript_Click" Tag="scoop:7zip"/>
                        <Button Style="{StaticResource ActionBtn}" Content="qBittorrent" Click="BtnScript_Click" Tag="scoop:qbittorrent"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Everything" Click="BtnScript_Click" Tag="scoop:everything"/>
                        <Button Style="{StaticResource ActionBtn}" Content="Notepad++" Click="BtnScript_Click" Tag="scoop:notepadplusplus"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PANNELLO 4: Stato Sistema Integrato -->
            <Grid x:Name="PanelStato" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Analisi e Stato del Sistema" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button Style="{StaticResource ActionBtn}" Content="System Info" Click="BtnSystem_Click" Tag="sysinfo"/>
                    <Button Style="{StaticResource ActionBtn}" Content="IP Config" Click="BtnSystem_Click" Tag="ipconfig"/>
                    <Button Style="{StaticResource ActionBtn}" Content="Patch Installate" Click="BtnSystem_Click" Tag="hotfix"/>
                    <Button Style="{StaticResource ActionBtn}" Content="Pulisci Schermo" Click="BtnSystem_Click" Tag="clear"/>
                </WrapPanel>

                <!-- Schermo nero per l'output -->
                <Border Grid.Row="2" Background="#0c0c0c" CornerRadius="5" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtOutput" Text="Pronto. Clicca un pulsante per interrogare il sistema..." 
                                   Foreground="#00FF00" FontFamily="Consolas" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>